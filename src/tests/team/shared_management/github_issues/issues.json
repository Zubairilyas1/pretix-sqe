[
  {"id": "D-Z01", "title": "Waiting-list auto-disable uses real now() instead of now_dt in QuotaAvailability",
   "severity": "Minor", "priority": "P2", "status": "Open (fix PR prepared)", "triage": "Fix in this repository",
   "found_by": "Area 1 (Zubair), white-box review of pretix/base/services/quotas.py", "risk": "PR-WB-01",
   "evidence": "`src/tests/team/zubair/test_dz01_waitinglist_now_dt.py`: waiting_list_auto_disable = tomorrow, one waiting-list entry, `QuotaAvailability().compute(now_dt=now()+2 days)`.",
   "expected": "At now_dt the waiting list is already disabled, so the entry is not counted: availability (OK, 5).",
   "actual": "The entry is still counted: availability (OK, 4). `assert 1 == 0` on count_waitinglist.",
   "root_cause": "`_compute_waitinglist` (quotas.py L461) compares the auto-disable date with `now()`; vouchers and carts use the `now_dt` argument of `compute()`.",
   "fix": "Pass `now_dt` from `_compute` to `_compute_waitinglist` and compare with it.",
   "labels": ["defect", "severity:minor", "priority:P2", "area:1-whitebox", "triage:fix"]},
